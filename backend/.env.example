DATABASE_URL=sqlite:///./bowling.db
OPERATION_MODE=emulation
TRANSPORT=mock
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600
TCP_HOST=192.168.4.1
TCP_PORT=2323
XOR_MASK_HEX=00
CHECKSUM_VARIANT=sum256
FRAME_LENGTH=30
LANES_COUNT=12
LANES_START_NUMBER=1
POLL_INTERVAL_MS=15
POLL_TIMEOUT_MS=30
INTER_PACKET_DELAY_MS=15
AUTO_BAUD_SWITCH=true
MQTT_HOST=192.168.2.67
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=bowling-backend
MQTT_ENABLED=true
STATIC_DIR=./static
SNAPSHOTS_DIR=./static/snapshots
SNAPSHOTS_MAX_AGE_DAYS=30
SNAPSHOTS_MAX_PER_CAMERA=1000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.2.67:3000
